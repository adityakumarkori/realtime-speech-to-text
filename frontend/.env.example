# Base URL of the FastAPI backend (scheme and host only, no path).
# Leave unset during local development to use the Vite proxy.
# Local backend:
# VITE_BACKEND_URL=http://127.0.0.1:8000
# Deployed backend:
# VITE_BACKEND_URL=https://api.example.com

# Optional WebSocket-only override. Usually VITE_BACKEND_URL is enough.
# VITE_WS_URL=wss://api.example.com
