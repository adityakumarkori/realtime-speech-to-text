# Copy this file to .env and set your backend origin.
# Local backend (default):
VITE_BACKEND_URL=http://127.0.0.1:8000
# Deployed backend example:
# VITE_BACKEND_URL=https://your-backend.example.com
# Leave the value empty to use the Vite development proxy.

# Optional WebSocket-only override. Usually VITE_BACKEND_URL is enough.
# VITE_WS_URL=wss://your-backend.example.com
